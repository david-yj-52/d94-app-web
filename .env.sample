# ============================================================
# web-plate 로컬 실행용 환경 변수 샘플 (admin 모드)
# 사용법: 이 파일을 .env.local 로 복사한 뒤 값을 채우고 `npm run dev`
# ============================================================

# ---- 인증 (next-auth v5) ----
# JWT 서명용 시크릿. 생성: npx auth secret  또는  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-32-byte-secret
# `next start` 등 localhost 외 호스트에서 실행할 때 필요
# AUTH_TRUST_HOST=true

# ---- 임시 admin 로그인 ----
# true 이면 백엔드 없이 admin / admin 으로 로그인 가능 (NODE_ENV=production 에서는 무시됨)
# 백엔드 복구 후 false 로 변경하거나 삭제
DEV_ADMIN_LOGIN=true

# ---- 임시 Mock API ----
# true 이면 /api/proxy 요청을 백엔드 대신 src/lib/mock 의 Mock 데이터로 응답 (NODE_ENV=production 에서는 무시됨)
# 데이터는 서버 메모리에만 저장되며 dev 서버 재시작 시 초기화됨
DEV_MOCK_API=true

# ---- 백엔드 ----
# 서버사이드 호출(/api/proxy, 로그인)에서 사용하는 백엔드 주소
BACKEND_URL=http://localhost:8080
# 브라우저에서 직접 연결하는 알림 SSE 주소 (보통 BACKEND_URL 과 동일)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# ---- 로컬 Agent ----
# 미설정 시 기본값 http://127.0.0.1:8080
NEXT_PUBLIC_LOCAL_URL=http://127.0.0.1:8080

# ---- Solace 메시징 ----
# 현재 solaceConfig.ts 에서는 admin/admin 하드코딩 값을 사용 중 (아래 값은 미사용)
SOLACE_USER_NAME=admin
SOLACE_USER_PWD=admin
